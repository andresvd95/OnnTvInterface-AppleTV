{
  "$description": "ONN LAUNCHER — tokens de diseño (fuente única). Base Android TV 960x540 dp (1080p a 2x); 720p y 4K escalan por densidad de Android.",
  "color": {
    "background":   { "$value": "#0D1424", "$type": "color" },
    "wallpaper-a":  { "$value": "#1B2A52", "$type": "color" },
    "wallpaper-b":  { "$value": "#2A1F4D", "$type": "color" },
    "surface":      { "$value": "rgba(255,255,255,0.09)", "$type": "color", "$description": "Vidrio: capa translúcida sobre fondo pre-desenfocado" },
    "surface-strong": { "$value": "rgba(30,38,60,0.82)", "$type": "color", "$description": "Vidrio de menús (más opaco para legibilidad)" },
    "border":       { "$value": "rgba(255,255,255,0.16)", "$type": "color" },
    "text":         { "$value": "#F4F6FB", "$type": "color" },
    "text-muted":   { "$value": "rgba(244,246,251,0.62)", "$type": "color" },
    "primary":      { "$value": "#2F5BD3", "$type": "color", "$description": "Avatar / acentos" },
    "secondary":    { "$value": "#5B6B8C", "$type": "color" },
    "focus":        { "$value": "#FFFFFF", "$type": "color" },
    "on-focus":     { "$value": "#0D1424", "$type": "color" },
    "success":      { "$value": "#3CCB7F", "$type": "color" },
    "warning":      { "$value": "#FFC145", "$type": "color" },
    "danger":       { "$value": "#FF6B5A", "$type": "color", "$description": "Punto de notificación" },
    "info":         { "$value": "#6EA8FF", "$type": "color" }
  },
  "typography": {
    "family": { "$value": "Google Sans, Roboto, sans-serif", "$description": "Fuentes del sistema en Google TV; sin tipografías de Apple" },
    "size": { "xs": "12sp", "sm": "14sp", "md": "16sp", "lg": "20sp", "xl": "28sp", "2xl": "36sp", "3xl": "48sp" },
    "weight": { "regular": 400, "medium": 500 },
    "line-height": { "tight": 1.1, "normal": 1.4 },
    "min-on-screen": { "$value": "12sp", "$description": "Mínimo legible a 3 m" }
  },
  "spacing": { "base": "4dp", "1": "4dp", "2": "8dp", "3": "12dp", "4": "16dp", "6": "24dp", "8": "32dp", "12": "48dp", "safe-x": "48dp", "safe-y": "27dp" },
  "radius": { "none": "0dp", "sm": "8dp", "md": "12dp", "lg": "16dp", "full": "999dp" },
  "elevation": { "0": "none", "1": "glass border", "2": "glass + focus scale", "3": "menu surface-strong", "4": "reservado" },
  "size": {
    "tile-app": { "width": "160dp", "height": "90dp", "$description": "16:9, banner de TV" },
    "tile-recent": { "width": "120dp", "height": "68dp" },
    "icon-button": "40dp",
    "focus-ring": "2dp",
    "focus-scale": 1.1
  },
  "breakpoints": { "tv-720p": "1280x720", "tv-1080p": "1920x1080", "tv-4k": "3840x2160" },
  "motion": {
    "duration": { "fast": "120ms", "base": "200ms", "slow": "320ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
    "reduced-motion": "Si Ajustes > Accesibilidad > Quitar animaciones está activo: sin escala de foco animada, cambio inmediato"
  }
}
